@page "/sales"
@attribute [Authorize(Policy = Permissions.ViewSales)]
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject InventoryApiClient Api
@inject NavigationManager Navigation

<PageTitle>Sales - Inventory Manager</PageTitle>

<PageHeading Title="Sales" Subtitle="@($"{_pageInfo?.TotalCount ?? 0} transaction(s)")">
    <Actions>
        <AuthorizeView Policy="@Permissions.ManageSales">
            <FluentButton Appearance="Appearance.Accent"
                          IconStart="@(new Icons.Regular.Size16.Add())"
                          OnClick="@(() => Navigation.NavigateTo("/sales/new"))">
                New sale
            </FluentButton>
        </AuthorizeView>
    </Actions>
</PageHeading>

<div class="toolbar">
    <div class="toolbar__grow">
        <FluentSearch @bind-Value="_search" @bind-Value:after="ReloadFirstPageAsync"
                      Immediate="true" ImmediateDelay="350"
                      Label="Search" Placeholder="Sale number or customer" Style="width:100%" />
    </div>

    <FluentSelect TOption="string" Label="Status" Items="@_statusOptions"
                  OptionValue="@(s => s)" OptionText="@(s => s)"
                  @bind-Value="_statusFilter" @bind-Value:after="ReloadFirstPageAsync" Width="160px" />

    <FluentDatePicker @bind-Value="_fromDate" @bind-Value:after="ReloadFirstPageAsync"
                      Label="From" Style="width:150px" />
    <FluentDatePicker @bind-Value="_toDate" @bind-Value:after="ReloadFirstPageAsync"
                      Label="To" Style="width:150px" />
</div>

@if (_error is not null)
{
    <StateBlock State="StateBlock.BlockState.Error" Message="@_error" OnRetry="ReloadAsync" />
}
else if (_loading && _items.Count == 0)
{
    <StateBlock State="StateBlock.BlockState.Loading" Message="Loading sales..." />
}
else if (_items.Count == 0)
{
    <StateBlock State="StateBlock.BlockState.Empty"
                Title="No sales recorded"
                Message="Record a sale to reduce stock and build up your sales history." />
}
else
{
    <FluentCard>
        <div class="grid-scroll" style="opacity:@(_loading ? "0.6" : "1");">
            <FluentDataGrid Items="@_items.AsQueryable()" TGridItem="SaleDto"
                            GridTemplateColumns="1.1fr 1.7fr 1fr 0.9fr 0.6fr 1fr 0.8fr">
                <TemplateColumn Title="Sale">
                    <FluentAnchor Appearance="Appearance.Hypertext" Href="@($"/sales/{context.Id}")">
                        @context.SaleNumber
                    </FluentAnchor>
                </TemplateColumn>

                <PropertyColumn Property="@(s => s.CustomerName)" Title="Customer" Sortable="true" />

                <TemplateColumn Title="Date">@FormatHelpers.Date(context.SaleDateUtc)</TemplateColumn>

                <TemplateColumn Title="Status">
                    <FluentBadge Appearance="Appearance.Neutral"
                                 BackgroundColor="@FormatHelpers.SaleStatusColor(context.Status)"
                                 Color="white">
                        @FormatHelpers.SaleStatusLabel(context.Status)
                    </FluentBadge>
                </TemplateColumn>

                <TemplateColumn Title="Lines" Align="Align.End">
                    <span class="numeric">@context.Items.Count</span>
                </TemplateColumn>

                <TemplateColumn Title="Total" Align="Align.End" Sortable="true">
                    <span class="numeric">@FormatHelpers.Money(context.Total)</span>
                </TemplateColumn>

                <TemplateColumn Title="Actions" Align="Align.End">
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Eye())"
                                  Title="Open sale"
                                  OnClick="@(() => Navigation.NavigateTo($"/sales/{context.Id}"))" />
                </TemplateColumn>
            </FluentDataGrid>
        </div>

        <Pager PageInfo="_pageInfo" CurrentPage="_page" Busy="_loading" OnPageChanged="GoToPageAsync" />
    </FluentCard>
}

@code {
    private readonly List<SaleDto> _items = [];
    private PageInfo? _pageInfo;

    private readonly string[] _statusOptions = ["All", "Completed", "Cancelled"];
    private string _search = string.Empty;
    private string _statusFilter = "All";
    private DateTime? _fromDate;
    private DateTime? _toDate;

    private int _page = 1;
    private bool _loading = true;
    private string? _error;
    private CancellationTokenSource? _cts;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task ReloadFirstPageAsync()
    {
        _page = 1;
        return ReloadAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _loading = true;
        _error = null;

        try
        {
            var request = new ListSalesRequest
            {
                Page = new PageRequest { Page = _page, PageSize = 20, Search = _search ?? string.Empty },
                DateRange = new DateRange()
            };

            if (_fromDate.HasValue) request.DateRange.FromUtc = FormatHelpers.ToIso(_fromDate.Value.Date);
            if (_toDate.HasValue) request.DateRange.ToUtc = FormatHelpers.ToIso(_toDate.Value.Date);

            var status = _statusFilter switch
            {
                "Completed" => SaleStatus.Completed,
                "Cancelled" => SaleStatus.Cancelled,
                _ => SaleStatus.Unspecified
            };

            if (status != SaleStatus.Unspecified)
            {
                request.Status = status;
            }

            var response = await Api.ListSalesAsync(request, _cts.Token);
            _items.Clear();
            _items.AddRange(response.Items);
            _pageInfo = response.PageInfo;
            _page = response.PageInfo.Page == 0 ? 1 : response.PageInfo.Page;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException) { }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose() => _cts?.Cancel();
}
