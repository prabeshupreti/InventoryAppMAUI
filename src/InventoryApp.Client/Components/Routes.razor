@using Microsoft.AspNetCore.Components.Authorization

<FluentDesignTheme Mode="DesignThemeModes.System" StorageName="inventoryapp-theme" />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(MauiProgram).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="content-area">
                            <FluentMessageBar Title="Access denied" Intent="@MessageIntent.Error">
                                You do not have permission to view this page. Contact an administrator
                                if you believe this is a mistake.
                            </FluentMessageBar>
                        </div>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="state-block">
                        <FluentProgressRing />
                        <span>Checking your permissions...</span>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="content-area">
                    <FluentMessageBar Title="Page not found" Intent="@MessageIntent.Warning">
                        That page does not exist. Use the navigation menu to get back on track.
                    </FluentMessageBar>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

<FluentToastProvider MaxToastCount="4" Position="@ToastPosition.TopRight" />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />
