@inherits LayoutComponentBase
@inject InventoryAuthStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IDialogService DialogService

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <header class="app-header">
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size20.Navigation())"
                              Title="Toggle navigation"
                              Class="app-header__toggle"
                              OnClick="@ToggleNav" />

                <FluentIcon Value="@(new Icons.Filled.Size24.BoxMultiple())" Color="Color.Fill" />
                <span class="app-header__title">Inventory Manager</span>

                <div class="app-header__spacer"></div>

                <span class="app-header__user">
                    @context.User.FindFirst("fullName")?.Value
                </span>

                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size20.Person())"
                              Title="My account"
                              OnClick="GoToProfile" />

                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size20.SignOut())"
                              Title="Sign out"
                              OnClick="ConfirmSignOutAsync" />
            </header>

            <div class="app-body">
                <aside class="app-nav @(_navExpanded ? "app-nav--open" : "app-nav--closed")">
                    <NavMenu OnNavigate="@CloseNavOnMobile" />
                </aside>

                @if (_navExpanded)
                {
                    <div class="app-nav__scrim" @onclick="CloseNav"></div>
                }

                <main class="app-content">
                    <ErrorBoundary @ref="_errorBoundary">
                        <ChildContent>
                            <div class="content-area">
                                @Body
                            </div>
                        </ChildContent>
                        <ErrorContent Context="exception">
                            <div class="content-area">
                                <FluentMessageBar Title="Something went wrong" Intent="@MessageIntent.Error">
                                    @exception.Message
                                    <FluentButton Appearance="Appearance.Accent" Class="mt-2"
                                                  OnClick="RecoverAsync">
                                        Reload this page
                                    </FluentButton>
                                </FluentMessageBar>
                            </div>
                        </ErrorContent>
                    </ErrorBoundary>
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

<style>
    /* App shell owns the full viewport - both html and body are 100% in app.css */
    .app-shell {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
        overflow: hidden;
        background: var(--neutral-layer-1);
    }

    .app-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 12px;
        height: 48px;
        flex-shrink: 0;
        background: var(--neutral-layer-4);
        color: var(--neutral-fill-inverse-rest);
        border-bottom: 1px solid var(--neutral-stroke-divider-rest);
        z-index: 5;
    }

    .app-header__title {
        font-size: var(--type-ramp-plus-1-font-size);
        font-weight: 600;
        color: var(--neutral-fill-inverse-rest);
    }

    .app-header__spacer {
        flex: 1;
    }

    .app-header__user {
        color: var(--neutral-fill-inverse-rest);
        font-size: var(--type-ramp-base-font-size);
        opacity: 0.9;
    }

    /* Body row: nav on the left, content fills the rest. */
    .app-body {
        flex: 1;
        display: flex;
        min-height: 0; /* critical: lets the child .app-content actually scroll */
        position: relative;
    }

    .app-nav {
        width: 240px;
        flex-shrink: 0;
        background: var(--neutral-layer-2);
        border-right: 1px solid var(--neutral-stroke-divider-rest);
        overflow-y: auto;
        overflow-x: hidden;
    }

    .app-content {
        flex: 1;
        min-width: 0;
        overflow-y: auto;
        overflow-x: hidden;
        background: var(--neutral-layer-1);
    }

    .app-nav__scrim {
        display: none;
    }

    /* Hide desktop toggle by default */
    .app-header__toggle {
        display: none;
    }

    /* Mobile: overlay nav */
    @@media (max-width: 860px) {
        .app-header__toggle {
            display: inline-flex;
        }

        .app-header__user {
            display: none;
        }

        .app-nav {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 10;
            box-shadow: var(--elevation-shadow-flyout);
            transition: transform 180ms ease;
        }

        .app-nav--closed {
            transform: translateX(-105%);
        }

        .app-nav--open {
            transform: translateX(0);
        }

        .app-nav__scrim {
            display: block;
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.3);
            z-index: 9;
        }
    }
</style>

@code {
    private bool _navExpanded = true;
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        // Start collapsed on mobile; the JS media-query bridge is overkill for this.
        // On first render the CSS media query hides the toggle anyway, so this only
        // matters for narrow desktop windows.
        _navExpanded = true;
    }

    private void ToggleNav() => _navExpanded = !_navExpanded;

    private void CloseNav() => _navExpanded = false;

    private void CloseNavOnMobile()
    {
        // NavMenu raises this on link click so the overlay dismisses itself on mobile.
        // On desktop the CSS keeps the nav visible regardless of this flag.
        _navExpanded = false;
    }

    private void GoToProfile() => Navigation.NavigateTo("/account");

    private Task RecoverAsync()
    {
        _errorBoundary?.Recover();
        return Task.CompletedTask;
    }

    private async Task ConfirmSignOutAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            "Any unsaved work on this screen will be lost.",
            "Sign out",
            "Stay signed in",
            "Sign out of Inventory Manager?");

        var result = await dialog.Result;
        if (result.Cancelled)
        {
            return;
        }

        await AuthProvider.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }
}