<div @onclick="OnClickHandler">
    <NavLink href="@Href" Match="@Match" class="nav-item" ActiveClass="nav-item--active">
        @if (Icon is not null)
        {
            <FluentIcon Value="@Icon" />
        }
        <span class="nav-item__label">@Label</span>
        @if (!string.IsNullOrEmpty(Badge))
        {
            <span class="nav-item__badge">@Badge</span>
        }
    </NavLink>
</div>

<style>
    .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 4px;
        color: var(--neutral-foreground-rest);
        text-decoration: none;
        font-size: var(--type-ramp-base-font-size);
        cursor: pointer;
        user-select: none;
    }

    .nav-item:hover {
        background: var(--neutral-fill-stealth-hover);
    }

    .nav-item--active {
        background: var(--accent-fill-rest);
        color: var(--foreground-on-accent-rest);
    }

    .nav-item--active fluent-icon {
        color: var(--foreground-on-accent-rest);
    }

    .nav-item__label {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .nav-item__badge {
        min-width: 20px;
        padding: 0 6px;
        border-radius: 999px;
        background: var(--accent-fill-rest);
        color: var(--foreground-on-accent-rest);
        font-size: var(--type-ramp-minus-1-font-size);
        text-align: center;
        line-height: 18px;
        font-weight: 600;
    }

    .nav-item--active .nav-item__badge {
        background: var(--foreground-on-accent-rest);
        color: var(--accent-fill-rest);
    }
</style>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "/";
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public Icon? Icon { get; set; }
    [Parameter] public string? Badge { get; set; }
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task OnClickHandler()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}