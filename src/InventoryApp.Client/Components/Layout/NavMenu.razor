@implements IDisposable
@inject AppState AppState
@inject NavigationManager Navigation

<nav class="nav-menu">
    <NavItem Href="/" Match="NavLinkMatch.All"
             Icon="@(new Icons.Regular.Size20.Board())" Label="Dashboard"
             OnClick="@(() => OnNavigate.InvokeAsync())" />

    <AuthorizeView Policy="@Permissions.ViewProducts">
        <NavItem Href="/products"
                 Icon="@(new Icons.Regular.Size20.BoxMultiple())" Label="Products"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ViewCatalog">
        <div class="nav-menu__group">Catalogue</div>
        <NavItem Href="/categories"
                 Icon="@(new Icons.Regular.Size20.Tag())" Label="Categories"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
        <NavItem Href="/suppliers"
                 Icon="@(new Icons.Regular.Size20.Building())" Label="Suppliers"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ViewStock">
        <div class="nav-menu__group">Stock</div>
        <NavItem Href="/stock"
                 Icon="@(new Icons.Regular.Size20.ArrowSwap())" Label="Movements"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
        <NavItem Href="/stock/alerts"
                 Icon="@(new Icons.Regular.Size20.Warning())" Label="Low stock"
                 Badge="@(AppState.LowStockCount > 0 ? AppState.LowStockCount.ToString() : null)"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ViewPurchases">
        <div class="nav-menu__group">Trade</div>
        <NavItem Href="/purchases"
                 Icon="@(new Icons.Regular.Size20.Cart())" Label="Purchases"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ViewSales">
        <NavItem Href="/sales"
                 Icon="@(new Icons.Regular.Size20.Receipt())" Label="Sales"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ViewReports">
        <NavItem Href="/reports"
                 Icon="@(new Icons.Regular.Size20.DocumentText())" Label="Reports"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.ManageUsers">
        <div class="nav-menu__group">Administration</div>
        <NavItem Href="/users"
                 Icon="@(new Icons.Regular.Size20.People())" Label="Users"
                 OnClick="@(() => OnNavigate.InvokeAsync())" />
    </AuthorizeView>
</nav>

<style>
    .nav-menu {
        display: flex;
        flex-direction: column;
        padding: 8px 6px 24px;
        gap: 2px;
    }

    .nav-menu__group {
        padding: 14px 12px 4px;
        font-size: var(--type-ramp-minus-1-font-size);
        color: var(--neutral-foreground-hint);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
    }
</style>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    protected override void OnInitialized() => AppState.Changed += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AppState.Changed -= OnStateChanged;
}