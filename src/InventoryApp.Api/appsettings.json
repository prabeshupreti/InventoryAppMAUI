{
  "ConnectionStrings": {
    "Default": "Data Source=inventory.db"
  },
  "Jwt": {
    "Issuer": "InventoryApp",
    "Audience": "InventoryApp.Client",
    "SigningKey": "REPLACE-THIS-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS",
    "ExpiryMinutes": 480
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/inventory-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
